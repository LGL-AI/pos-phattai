+
+const production='vn.lotusai.pos.phattaiapp',legacy='vn.lotusai.pos.handheld';
+const expected=resolveAndroidIdentity({});
+const badging=(id=production,code=162,name='1.6.2',activity=production+'.MainActivity')=>`package: name='${id}' versionCode='${code}' versionName='${name}' platformBuildVersionName='15'\nlaunchable-activity: name='${activity}' label='Lotus POS' icon=''\n`;
