{
  "name": "lotus-pos-phattai-cloud-d1",
  "version": "2.6.0-phattai.3",
  "private": true,
  "type": "module",
  "description": "Lotus POS online riêng cho TIỆM SÍU LẬP PHÁT TÀI: Worker + D1 + SUNMI handheld source",
  "scripts": {
    "dev": "wrangler dev",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "node scripts/deploy-remote.mjs --migrate-only",
    "deploy": "wrangler deploy",
    "test": "node --test tests/phattai-isolation.test.mjs",
    "check:d1": "node scripts/check-d1-ready.mjs",
    "check:cloud": "node scripts/check-cloud-health.mjs",
    "deploy:remote": "node scripts/deploy-remote.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
