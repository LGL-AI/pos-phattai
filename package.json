{
  "name": "lotus-pos-phattai-cloud-d1",
  "version": "2.11.3-phattai.1",
  "private": true,
  "type": "module",
  "description": "Lotus POS online riêng cho TIỆM SÍU LẬP PHÁT TÀI: Worker + D1 + SUNMI handheld source",
  "scripts": {
    "dev": "wrangler dev",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "node scripts/deploy-remote.mjs --migrate-only",
    "deploy": "node scripts/deploy-remote.mjs",
    "test": "npm run test:all",
    "check:d1": "node scripts/check-d1-ready.mjs",
    "check:cloud": "node scripts/check-cloud-health.mjs",
    "deploy:remote": "node scripts/deploy-remote.mjs",
    "test:qa120": "node --test tests/phattai-v152-qa120.test.mjs",
    "test:legacy6": "node --test tests/phattai-isolation.test.mjs",
    "test:all": "node scripts/run-tests.mjs",
    "test:qrzh": "node --test tests/phattai-qr-zh.test.mjs",
    "test:deep": "node --test tests/phattai-crossflow-deep.test.mjs tests/phattai-bridge-d1.test.mjs tests/phattai-v157-handoff.test.mjs tests/phattai-v160-stability.test.mjs tests/phattai-v161-order-recovery.test.mjs",
    "sync:android": "node scripts/sync-android-assets.mjs",
    "verify:assets": "node scripts/verify-android-assets.mjs",
    "release:gate": "npm run sync:android && node scripts/verify-release.mjs",
    "verify:apk": "node scripts/verify-apk-assets.mjs",
    "test:runtime": "node scripts/runtime-smoke.mjs",
    "benchmark:sync": "node scripts/benchmark-sync.mjs",
    "verify:apk:identity": "node scripts/verify-apk-identity.mjs",
    "publish:android": "node scripts/publish-android-release.mjs",
    "verify:android:catalog": "node scripts/verify-android-release-catalog.mjs",
    "test:e2e": "node scripts/e2e-staff.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "miniflare": "5.20260926.1-alpha",
    "playwright": "^1.63.0",
    "wrangler": "4.144.0"
  },
  "engines": {
    "node": ">=22"
  }
}
