{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pos-phattai",
  "workers_dev": true,
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "pos_phattai", "database_id": "REPLACE_WITH_PHATTAI_D1_DATABASE_ID", "migrations_dir": "migrations" }
  ],
  "vars": {
    "ORDERING_ENABLED": "true"
  },
  "secrets": {
    "required": ["SESSION_SECRET", "POS_STAFF_PASSWORD"]
  }
}
