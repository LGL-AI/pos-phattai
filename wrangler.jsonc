{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pos-phattai",
  "workers_dev": true,
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pos_phattai",
      "database_id": "9f268f6c-591b-4517-806a-15ed4a0bfdbf",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ORDERING_ENABLED": "true"
  },
  "secrets": {
    "required": [
      "SESSION_SECRET",
      "POS_STAFF_PASSWORD"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME",
        "class_name": "RealtimeHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "realtime-v1",
      "new_sqlite_classes": [
        "RealtimeHub"
      ]
    }
  ],
  "previews": {
    "vars": {
      "ORDERING_ENABLED": "false"
    },
    "d1_databases": [],
    "durable_objects": {
      "bindings": [
        {
          "name": "REALTIME",
          "class_name": "RealtimeHub"
        }
      ]
    }
  }
}
